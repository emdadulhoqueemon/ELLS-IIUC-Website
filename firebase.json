{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "New folder",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/ELLS Committee Autumn 2026.pdf"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
