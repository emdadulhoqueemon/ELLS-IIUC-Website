rules_version = '2';

// ===========================================================================
// ELLS Club — Cloud Firestore Security Rules
// ---------------------------------------------------------------------------
// Deploy with:  firebase deploy --only firestore:rules
// or paste into: Firebase console → Firestore Database → Rules → Publish
//
// Model
//   notices/{noticeId}
//     • Anyone may READ  → the public homepage notice board.
//     • ONLY the authorised admin accounts may CREATE, UPDATE and DELETE:
//           emdadulhoquex@gmail.com      (IT Secretary)
//           ells.dell.iiuc95@gmail.com   (official ELLS club account)
//
//   events/{eventId}
//     • Anyone may READ  → the public events page (events.html).
//     • ONLY the authorised admin accounts may CREATE, UPDATE and DELETE:
//           emdadulhoquex@gmail.com      (IT Secretary)
//           ells.dell.iiuc95@gmail.com   (official ELLS club account)
//
//     • Anonymous visitors and every other account are denied all writes.
//     • Any other collection is denied entirely.
//
// ⚠️ The ONLY addresses allowed to write or delete ANY document are the two
//    accounts in the allowlist below — there is no other admin, editor or
//    moderator path in these rules. Keep the allowlist below in sync with
//    ADMIN_EMAILS in New folder/js/firebase-config.js — the rules are the
//    real security boundary; the JS constant only controls what the UI
//    lets you do.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist: every write path below funnels through this.
    // Both addresses are full administrators with identical rights.
    // Compared case-insensitively so a differently-cased token still matches.
    function isAdminEmail(email) {
      return email is string
        && email.lower() in [
             'emdadulhoquex@gmail.com',     // IT Secretary
             'ells.dell.iiuc95@gmail.com'   // Official ELLS club account
           ];
    }

    function isAdmin() {
      return request.auth != null
        && isAdminEmail(request.auth.token.email);
      // Optional hardening — uncomment once BOTH admin accounts have confirmed
      // their address (Authentication → Users → verified badge):
      //   && request.auth.token.email_verified == true
    }

    // Shape guard: every notice written from the dashboard must match it.
    function isValidNotice() {
      return request.resource.data.keys().hasOnly([
                'title', 'date', 'description',
                'createdAt', 'authorEmail', 'authorUid'
              ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 600
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.authorEmail is string
        && isAdminEmail(request.resource.data.authorEmail);
    }

    // Shape guard: every event written from the dashboard must match it.
    function isValidEvent() {
      return request.resource.data.keys().hasOnly([
                'title', 'category', 'description', 'date', 'time',
                'venue', 'registrationLink',
                'createdAt', 'authorEmail', 'authorUid'
              ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 3
        && request.resource.data.category.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 220
        && request.resource.data.date is string
        && request.resource.data.date.size() >= 2
        && request.resource.data.date.size() <= 48
        && request.resource.data.time is string
        && request.resource.data.time.size() >= 2
        && request.resource.data.time.size() <= 48
        && request.resource.data.venue is string
        && request.resource.data.venue.size() >= 2
        && request.resource.data.venue.size() <= 120
        && request.resource.data.registrationLink is string
        && request.resource.data.registrationLink.size() <= 600
        && request.resource.data.registrationLink.matches('^https?://.+$')
        && request.resource.data.authorEmail is string
        && isAdminEmail(request.resource.data.authorEmail);
    }

    match /notices/{noticeId} {
      // Public notice board — readable by everyone, signed in or not.
      allow read: if true;

      // Full create / update / delete access for both authorised admins.
      // The new document must be attributed to the signed-in admin; on update
      // the original author is preserved (either admin may edit either doc).
      allow create: if isAdmin() && isValidNotice()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() && isValidNotice()
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      // Public events page — readable by everyone, signed in or not.
      allow read: if true;

      // Full create / update / delete access for both authorised admins.
      // The new document must be attributed to the signed-in admin; on update
      // the original author is preserved (either admin may edit either doc).
      allow create: if isAdmin() && isValidEvent()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() && isValidEvent()
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
