rules_version = '2';

// ===========================================================================
// ELLS Club — Cloud Firestore Security Rules
// ---------------------------------------------------------------------------
// Deploy with:  firebase deploy --only firestore:rules
// or paste into: Firebase console → Firestore Database → Rules → Publish
//
// Model
//   notices/{noticeId}
//     • Anyone may READ  → the public homepage notice board.
//     • ONLY the IT Secretary account may CREATE, UPDATE and DELETE:
//           emdadulhoquex@gmail.com
//
//   events/{eventId}
//     • Anyone may READ  → the public events page (events.html).
//     • ONLY the IT Secretary account may CREATE, UPDATE and DELETE:
//           emdadulhoquex@gmail.com
//
//     • Anonymous visitors and every other account are denied all writes.
//     • Any other collection is denied entirely.
//
// ⚠️ The ONLY address allowed to write or delete ANY document is
//    emdadulhoquex@gmail.com — there is no other admin, editor or moderator
//    path in these rules. Keep the admin address below in sync with
//    ADMIN_EMAILS in New folder/js/firebase-config.js — the rules are the
//    real security boundary; the JS constant only controls what the UI
//    lets you do.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Single-admin allowlist: every write path below funnels through this.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'emdadulhoquex@gmail.com';
      // Optional hardening — uncomment once the admin account has confirmed
      // its address (Authentication → Users → verified badge):
      //   && request.auth.token.email_verified == true
    }

    // Shape guard: every notice written from the dashboard must match it.
    function isValidNotice() {
      return request.resource.data.keys().hasOnly([
                'title', 'date', 'description',
                'createdAt', 'authorEmail', 'authorUid'
              ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 600
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.authorUid == request.auth.uid;
    }

    // Shape guard: every event written from the dashboard must match it.
    function isValidEvent() {
      return request.resource.data.keys().hasOnly([
                'title', 'category', 'description', 'date', 'time',
                'venue', 'registrationLink',
                'createdAt', 'authorEmail', 'authorUid'
              ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 3
        && request.resource.data.category.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 220
        && request.resource.data.date is string
        && request.resource.data.date.size() >= 2
        && request.resource.data.date.size() <= 48
        && request.resource.data.time is string
        && request.resource.data.time.size() >= 2
        && request.resource.data.time.size() <= 48
        && request.resource.data.venue is string
        && request.resource.data.venue.size() >= 2
        && request.resource.data.venue.size() <= 120
        && request.resource.data.registrationLink is string
        && request.resource.data.registrationLink.size() <= 600
        && request.resource.data.registrationLink.matches('^https?://.+$')
        && request.resource.data.authorUid == request.auth.uid;
    }

    match /notices/{noticeId} {
      // Public notice board — readable by everyone, signed in or not.
      allow read: if true;

      // Write access is limited to the single authorised admin address.
      allow create, update: if isAdmin() && isValidNotice();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      // Public events page — readable by everyone, signed in or not.
      allow read: if true;

      // Write access is limited to the single authorised admin address.
      allow create, update: if isAdmin() && isValidEvent();
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
