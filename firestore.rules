rules_version = '2';

// ===========================================================================
// ELLS Club — Cloud Firestore Security Rules
// ---------------------------------------------------------------------------
// Deploy with:  firebase deploy --only firestore:rules
// or paste into: Firebase console → Firestore Database → Rules → Publish
//
// Model
//   notices/{noticeId}
//     • Anyone may READ  → the public homepage notice board.
//     • Only an authenticated admin may CREATE.
//     • Nobody may update or delete from the browser (use the console).
//
// Admins
//   Add the IT Secretary account(s) to the allowlist below. The email must
//   match exactly what you created in Firebase console → Authentication.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'it.secretary@ells-club.com'
          // add further committee emails here, comma separated
        ];
    }

    // Shape guard: every notice written from the dashboard must match it.
    function isValidNotice() {
      return request.resource.data.keys().hasOnly([
                'title', 'date', 'description',
                'createdAt', 'authorEmail', 'authorUid'
              ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 600
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.authorUid == request.auth.uid;
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNotice();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
